{
  "name": "react-native-wallet-pay",
  "version": "1.1.1",
  "description": "Biblioteca agnóstica para pagamentos com Apple Pay e Google Pay em React Native, compatível com qualquer gateway",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/diagnostics/testApplePaySetup": {
      "types": "./lib/diagnostics/testApplePaySetup.d.ts",
      "default": "./lib/diagnostics/testApplePaySetup.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "yarn build",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example:ios": "cd example && react-native run-ios",
    "example:android": "cd example && react-native run-android"
  },
  "keywords": [
    "react-native",
    "apple-pay",
    "google-pay",
    "payments",
    "wallet",
    "stripe",
    "paypal",
    "payment-gateway",
    "ios",
    "android",
    "passkit"
  ],
  "author": "Mitchelson Silva <mitchelsonps@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchelson/react-native-wallet-pay.git"
  },
  "homepage": "https://github.com/mitchelson/react-native-wallet-pay#readme",
  "bugs": {
    "url": "https://github.com/mitchelson/react-native-wallet-pay/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/jest": "^29.5.12",
    "@types/react-test-renderer": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.0.0",
    "prettier": "2.8.8",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "lib/",
    "src/",
    "ios/",
    "android/",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "TROUBLESHOOTING.md"
  ]
}
